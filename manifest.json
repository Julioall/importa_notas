{
  "manifest_version": 3,
  "name": "Importador de Notas",
  "version": "2.1.0",
  "description": "Importa correções no Moodle, gera relatórios de notas, lança feedback em massa, sinaliza pendências e baixa somente os envios que ainda precisam de correção.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "downloads",
    "storage"
  ],
  "action": {
    "default_title": "Configurações do Importador de Notas",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://ead.fieg.com.br/mod/assign/view.php*",
        "https://ead.fieg.com.br/course/view.php*",
        "https://ead.fieg.com.br/course/index.php*",
        "https://ead.senai.br/mod/assign/view.php*",
        "https://ead.senai.br/course/view.php*",
        "https://ead.senai.br/course/index.php*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css",
        "ui-refresh.css",
        "ui-fix.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://ead.fieg.com.br/my/courses.php*",
        "https://ead.senai.br/my/*"
      ],
      "js": [
        "grade-report.js"
      ],
      "css": [
        "grade-report.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://ead.fieg.com.br/*",
    "https://ead.senai.br/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
