{
  "manifest_version": 3,
  "name": "Importador de Notas",
  "version": "0.3.7",
  "description": "Importa CSV/XLSX com nome, nota e feedback para o Moodle, sem bloquear atividades sem nota.",
  "icons": {
    "48": "icons/icon48.png",
    "96": "icons/icon96.png"
  },
  "permissions": [],
  "content_scripts": [
    {
      "matches": [
        "https://*/mod/assign/view.php*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
