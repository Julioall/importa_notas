{
  "manifest_version": 3,
  "name": "Ferramentas Educacionais",
  "version": "3.0.0",
  "description": "Suíte modular para Moodle, Google Drive e Kahoot.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab", "downloads", "scripting", "storage", "tabs"],
  "host_permissions": [
    "https://ead.fieg.com.br/*",
    "https://ead.senai.br/*",
    "https://drive.google.com/*",
    "https://create.kahoot.it/*"
  ],
  "action": {
    "default_title": "Ferramentas Educacionais",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://ead.fieg.com.br/mod/assign/view.php*",
        "https://ead.fieg.com.br/course/view.php*",
        "https://ead.fieg.com.br/course/index.php*",
        "https://ead.senai.br/mod/assign/view.php*",
        "https://ead.senai.br/course/view.php*",
        "https://ead.senai.br/course/index.php*"
      ],
      "js": ["content.js", "import-flow.js"],
      "css": ["styles.css", "ui-refresh.css", "ui-fix.css", "import-flow.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://ead.fieg.com.br/my/courses.php*", "https://ead.senai.br/my/*"],
      "js": ["grade-report.js", "grade-report-cancel.js"],
      "css": ["grade-report.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://create.kahoot.it/*"],
      "js": ["modules/kahoot/content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {"service_worker": "background.js"}
}
